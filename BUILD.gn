# zxlog v0.4: C++17/Linux ELF/GCC, bundled MIT-licensed {fmt} 12.1 headers.
assert(zxlog_mode == "TEXT" || zxlog_mode == "BINARY" || zxlog_mode == "RUNTIME",
       "zxlog_mode must be TEXT, BINARY, or RUNTIME")

_mode_value = 3
if (zxlog_mode == "TEXT") {
  _mode_value = 1
} else if (zxlog_mode == "BINARY") {
  _mode_value = 2
}

config("common") {
  include_dirs = [ "include", "third_party/fmt/include" ]
  defines = [ "ZXLOG_BUILD_MODE=$_mode_value" ]
  cflags_cc = [
    "-std=c++17", "-Wall", "-Wextra", "-Werror", "-pthread",
    "-ffunction-sections", "-fdata-sections",
  ]
  ldflags = [ "-pthread", "-Wl,--gc-sections" ]
  if (zxlog_optimize) {
    cflags_cc += [ "-O2" ]
  } else {
    cflags_cc += [ "-O0", "-g" ]
  }
}

config("metadata_link") {
  inputs = [ "build/zxlog_meta.ld" ]
  ldflags = [ "-Wl,-T," + rebase_path(inputs[0], root_build_dir) ]
}

static_library("zxlog") {
  sources = [
    "src/logger.cc",
    "src/admission_state.cc",
    "src/async_runtime.cc",
    "src/dispatcher.cc",
    "include/zxlog/dispatcher.h",
    "src/diagnostics.cc",
    "src/output_backend.cc",
    "src/file_writer.cc",
    "src/sink.cc",
    "src/path_lease.cc",
    "src/identity.cc",
  ]
  if (zxlog_mode != "BINARY") {
    sources += [ "src/text_format.cc" ]
  }
  public_configs = [ ":common", ":metadata_link" ]
  include_dirs = [ "src" ]
}

# Inputs are intentionally explicit: any LogSite-changing file or build option
# must participate in the hash. Apps consuming zxlog supply their own source list.
_build_id_sources = [
  "BUILD.gn",
  ".gn",
  "build/BUILDCONFIG.gn",
  "build/toolchain/BUILD.gn",
  "build/zxlog_meta.ld",
  "include/zxlog/codec.h",
  "include/zxlog/crc32.h",
  "include/zxlog/logger.h",
  "include/zxlog/config.h",
  "include/zxlog/options.h",
  "include/zxlog/stats.h",
  "include/zxlog/detail/admission_state.h",
  "include/zxlog/detail/async_runtime.h",
  "include/zxlog/detail/diagnostics.h",
  "include/zxlog/detail/log_record.h",
  "include/zxlog/detail/output_backend.h",
  "include/zxlog/error.h",
  "include/zxlog/identity.h",
  "src/identity.cc",
  "tools/build_id.py",
  "tools/extract_dictionary.py",
  "tools/strip_metadata.py",
  "include/zxlog/protocol.h",
  "include/zxlog/site.h",
  "include/zxlog/zxlog.h",
  "src/logger.cc",
  "src/admission_state.cc",
  "src/async_runtime.cc",
  "src/dispatcher.cc",
  "include/zxlog/dispatcher.h",
  "src/diagnostics.cc",
  "src/output_backend.cc",
  "src/file_writer.cc",
  "src/file_writer.h",
  "src/sink.cc",
  "include/zxlog/sink.h",
  "src/path_lease.cc",
  "src/path_lease.h",
  "src/text_format.h",
  "third_party/fmt/include/fmt/base.h",
  "third_party/fmt/include/fmt/format.h",
  "third_party/fmt/include/fmt/format-inl.h",
  "third_party/fmt/include/fmt/args.h",
  "src/text_format.cc",
  "examples/basic.cc",
  "tests/unit.cc",
  "tests/multi_logger.cc",
  "tests/fault_io.cc",
  "tools/decode.cc",
]

action("generate_build_id") {
  script = "//tools/build_id.py"
  inputs = _build_id_sources
  outputs = [
    "$root_gen_dir/build_id.h",
    "$root_gen_dir/build_id.txt",
  ]
  args = [
    "--header", rebase_path(outputs[0], root_build_dir),
    "--id-file", rebase_path(outputs[1], root_build_dir),
    "--mode", zxlog_mode,
  ] + rebase_path(inputs, root_build_dir)
}

executable("zxlog_demo_raw") {
  sources = [ "examples/basic.cc" ]
  deps = [ ":zxlog", ":generate_build_id" ]
  include_dirs = [ "$root_gen_dir" ]
}

# Extract the dictionary from the linked ELF (not from runtime registration).
action("zxlog_dictionary") {
  script = "//tools/extract_dictionary.py"
  deps = [ ":zxlog_demo_raw", ":generate_build_id" ]
  inputs = [
    "$root_out_dir/zxlog_demo_raw",
    "$root_gen_dir/build_id.txt",
  ]
  outputs = [
    "$root_out_dir/zxlog.zdict",
    "$root_out_dir/zxlog_dictionary.json",
    "$root_out_dir/zxlog_demo_identified",
  ]
  args = [
    "--elf", rebase_path(inputs[0], root_build_dir),
    "--build-id-file", rebase_path(inputs[1], root_build_dir),
    "--output", rebase_path(outputs[0], root_build_dir),
    "--json", rebase_path(outputs[1], root_build_dir),
    "--patched-elf", rebase_path(outputs[2], root_build_dir),
  ]
}

# The deployable runtime image excludes the zxlog_meta section. The build-time
# dictionary remains alongside build artifacts for recovering binary logs.
action("prepare_runtime_image") {
  script = "//tools/strip_metadata.py"
  deps = [ ":zxlog_dictionary", ":zxlog_demo_raw" ]
  inputs = [ "$root_out_dir/zxlog_demo_identified", "$root_out_dir/zxlog.zdict",
             "$root_out_dir/zxlog_dictionary.json", "tools/extract_dictionary.py" ]
  outputs = [ "$root_out_dir/zxlog_demo", "$root_out_dir/zxlog_demo.manifest.json" ]
  args = [
    "--input", rebase_path(inputs[0], root_build_dir),
    "--output", rebase_path(outputs[0], root_build_dir),
    "--dict", rebase_path(inputs[1], root_build_dir),
    "--metadata-json", rebase_path(inputs[2], root_build_dir),
    "--manifest", rebase_path(outputs[1], root_build_dir),
  ]
}

# Host offline decoder always has text formatting capability, including in a
# BINARY-only build. Not linked to the device binary or zxlog library.
executable("zxlog_decode") {
  sources = [ "tools/decode.cc", "src/text_format.cc" ]
  configs = [ ":common" ]
  include_dirs = [ "src" ]
}

executable("zxlog_unit") {
  sources = [ "tests/unit.cc" ]
  configs = [ ":common" ]
}

executable("zxlog_multi_raw") {
  sources = [ "tests/multi_logger.cc", "tests/fault_io.cc" ]
  ldflags = [ "-Wl,--wrap=write,--wrap=fdatasync,--wrap=rename" ]
  deps = [ ":zxlog", ":generate_build_id" ]
  include_dirs = [ "$root_gen_dir" ]
}

action("zxlog_multi_dictionary") {
  script = "//tools/extract_dictionary.py"
  deps = [ ":zxlog_multi_raw", ":generate_build_id" ]
  inputs = [ "$root_out_dir/zxlog_multi_raw", "$root_gen_dir/build_id.txt" ]
  outputs = [ "$root_out_dir/multi.zdict", "$root_out_dir/multi_dictionary.json",
              "$root_out_dir/zxlog_multi_identified" ]
  args = [
    "--elf", rebase_path(inputs[0], root_build_dir),
    "--build-id-file", rebase_path(inputs[1], root_build_dir),
    "--output", rebase_path(outputs[0], root_build_dir),
    "--json", rebase_path(outputs[1], root_build_dir),
    "--patched-elf", rebase_path(outputs[2], root_build_dir),
  ]
}

action("prepare_multi_image") {
  script = "//tools/strip_metadata.py"
  deps = [ ":zxlog_multi_dictionary", ":zxlog_multi_raw" ]
  inputs = [ "$root_out_dir/zxlog_multi_identified", "$root_out_dir/multi.zdict",
             "$root_out_dir/multi_dictionary.json", "tools/extract_dictionary.py" ]
  outputs = [ "$root_out_dir/zxlog_multi", "$root_out_dir/zxlog_multi.manifest.json" ]
  args = [
    "--input", rebase_path(inputs[0], root_build_dir),
    "--output", rebase_path(outputs[0], root_build_dir),
    "--dict", rebase_path(inputs[1], root_build_dir),
    "--metadata-json", rebase_path(inputs[2], root_build_dir),
    "--manifest", rebase_path(outputs[1], root_build_dir),
  ]
}

action("check_multi") {
  script = "//tests/multi_logger.py"
  deps = [ ":prepare_multi_image", ":zxlog_multi_dictionary", ":zxlog_decode" ]
  inputs = [
    "$root_out_dir/zxlog_multi", "$root_out_dir/multi.zdict", "$root_out_dir/zxlog_decode",
    "tools/decode.py", "tools/extract_dictionary.py",
  ]
  outputs = [ "$root_out_dir/check_multi.ok" ]
  args = [
    "--exe", rebase_path(inputs[0], root_build_dir),
    "--dict", rebase_path(inputs[1], root_build_dir),
    "--cpp-decoder", rebase_path(inputs[2], root_build_dir),
    "--mode", zxlog_mode,
    "--work", rebase_path("$root_out_dir/test-results/multi", root_build_dir),
    "--stamp", rebase_path(outputs[0], root_build_dir),
  ]
}

group("zxlog_all") {
  deps = [ ":prepare_runtime_image", ":zxlog_unit", ":zxlog_decode" ]
}

action("check_artifacts") {
  script = "//tests/artifacts.py"
  deps = [ ":prepare_runtime_image", ":prepare_multi_image", ":zxlog_decode",
           ":generate_build_id", ":zxlog_dictionary", ":zxlog_multi_dictionary",
           ":zxlog_demo_raw", ":zxlog_multi_raw" ]
  inputs = [
    "$root_out_dir/zxlog_demo", "$root_out_dir/zxlog_multi",
    "$root_out_dir/zxlog_demo_raw", "$root_out_dir/zxlog_multi_raw",
    "$root_out_dir/zxlog_demo_identified", "$root_out_dir/zxlog_multi_identified",
    "$root_out_dir/zxlog.zdict", "$root_out_dir/multi.zdict",
    "$root_out_dir/zxlog_demo.manifest.json", "$root_out_dir/zxlog_multi.manifest.json",
    "$root_out_dir/zxlog_dictionary.json", "$root_gen_dir/build_id.txt",
    "$root_out_dir/zxlog_decode", "tools/extract_dictionary.py", "tools/strip_metadata.py",
    "tools/decode.py",
  ]
  outputs = [ "$root_out_dir/check_artifacts.ok" ]
  args = [
    "--build", rebase_path(root_out_dir, root_build_dir),
    "--mode", zxlog_mode,
    "--stamp", rebase_path(outputs[0], root_build_dir),
  ]
}

# ninja -C out/Release check: end-to-end test on the build products.
action("check") {
  script = "//tests/integration.py"
  deps = [ ":prepare_runtime_image", ":zxlog_dictionary", ":zxlog_unit", ":zxlog_decode", ":check_multi", ":check_artifacts" ]
  inputs = [
    "$root_out_dir/zxlog_demo",
    "$root_out_dir/zxlog_unit",
    "$root_out_dir/zxlog.zdict",
    "$root_out_dir/zxlog_decode",
  ]
  outputs = [ "$root_out_dir/check.ok" ]
  args = [
    "--demo", rebase_path(inputs[0], root_build_dir),
    "--unit", rebase_path(inputs[1], root_build_dir),
    "--dict", rebase_path(inputs[2], root_build_dir),
    "--mode", zxlog_mode,
    "--work", rebase_path("$root_out_dir/test-results", root_build_dir),
    "--stamp", rebase_path(outputs[0], root_build_dir),
    "--cpp-decoder", rebase_path(inputs[3], root_build_dir),
  ]
}
