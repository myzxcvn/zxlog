# Minimal, standalone Linux/ELF GN build configuration.
declare_args() {
  zxlog_mode = "BINARY"   # TEXT, BINARY, or RUNTIME
  zxlog_optimize = true
  zxlog_active_level = 0  # compile out log sites below this severity
  zxlog_cxx = "g++"
  zxlog_cc = "gcc"
  zxlog_linker = "g++"
  zxlog_archiver = "ar"
  zxlog_extra_cflags = []
  zxlog_extra_ldflags = []
}
set_default_toolchain("//build/toolchain:default")
