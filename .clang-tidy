---
# Explicit first-stage profile. Keep this list versioned instead of enabling
# entire google-* or cppcoreguidelines-* families whose contents change with LLVM.
Checks: >
  -*,
  clang-analyzer-core.*,
  clang-analyzer-cplusplus.*,
  clang-analyzer-deadcode.*,
  bugprone-dangling-handle,
  bugprone-exception-escape,
  bugprone-implicit-widening-of-multiplication-result,
  bugprone-unchecked-optional-access,
  bugprone-use-after-move,
  cppcoreguidelines-narrowing-conversions,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  cppcoreguidelines-virtual-class-destructor,
  performance-no-automatic-move,
  performance-unnecessary-copy-initialization,
  performance-unnecessary-value-param
WarningsAsErrors: ''
HeaderFilterRegex: '(^|.*/)(include/zxlog|src|examples|tests|tools)/.*'
SystemHeaders: false
FormatStyle: file
...
